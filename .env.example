# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=xxx
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth -------------------------------------------
# Create credentials at: https://console.developers.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# Native Google Sign-In in the mobile apps (see docs/NATIVE_SIGN_IN.md).
# The app authenticates via Android Credential Manager / the iOS Google SDK and
# sends an ID token to the `google-native` provider — no browser redirect, so the
# session cookie is set inside the Capacitor WebView instead of Chrome/Safari.
#
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is the SAME value as GOOGLE_CLIENT_ID (the *web*
# client ID). Credential Manager uses it as its serverClientId, so it is also the
# `aud` claim of the ID token. It is exposed to the browser by design — a client
# ID is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx
# Optional. Leave blank to keep the browser fallback on iOS. When set, the iOS
# app signs in natively and the value must ALSO be set as GOOGLE_IOS_CLIENT_ID
# so the server accepts it as an `aud`.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Extra accepted `aud` values. Only needed when tokens are minted against a
# dedicated Android/iOS OAuth client rather than the web client.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple (App Store guideline 4.8 — required alongside Google login)
# APPLE_CLIENT_ID is the Services ID (e.g. com.example.clipper.web).
# APPLE_CLIENT_SECRET is a self-generated ES256 JWT signed with your Apple
# private key (Team ID + Key ID) — it expires after max 6 months; regenerate.
APPLE_CLIENT_ID=xxx
APPLE_CLIENT_SECRET=xxx
# Native Sign in with Apple on iOS uses ASAuthorizationController, whose identity
# token carries the app's BUNDLE ID as `aud` — not the Services ID above. Set it
# to the iOS bundle identifier (com.rclipper.app) or native Apple sign-in is
# rejected with apple:IdTokenInvalid. No client secret is needed for this path.
APPLE_NATIVE_CLIENT_ID=com.rclipper.app

# ---- Email --------------------------------------------------
# Production on DigitalOcean: use an HTTPS email API because Droplets block
# outbound SMTP ports 25, 465, and 587. A blocked port does not refuse the
# connection, it swallows it — so an SMTP send hangs rather than failing, and
# the signup/resend request hangs with it.
#
# Transport precedence (src/lib/email.ts): BREVO_API_KEY > RESEND_API_KEY > SMTP.
#
# BREVO_API_KEY is the v3 API key from https://app.brevo.com → SMTP & API →
# API keys. It is NOT the SMTP password below. Same Brevo account, port 443.
BREVO_API_KEY=
RESEND_API_KEY=
# Must be a sender verified in the provider's dashboard. Free webmail addresses
# (gmail.com, hotmail.com, ...) cannot be verified and are rejected.
EMAIL_FROM=RClipper <noreply@rclipper.com>
# Ceiling on a single send attempt, in ms. Keeps a stalled network path from
# holding an HTTP request open. Default 12000.
EMAIL_SEND_TIMEOUT_MS=12000

# SMTP fallback for local development or hosts that permit outbound SMTP.
# For local dev: use Mailtrap (https://mailtrap.io) or Ethereal (https://ethereal.email)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=xxx
SMTP_PASSWORD=xxx

# ---- Storage (DigitalOcean Spaces) --------------------------
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=sgp1
# Optional: CDN endpoint for faster public delivery (recommended for thumbnails/clips)
# DO_SPACES_CDN_ENDPOINT=https://your-bucket-name.sgp1.cdn.digitaloceanspaces.com

# ---- Database (Amazon RDS) ----------------------------------
# Credentials below are read directly by src/lib/db.ts via the PG* env vars.

# ---- App Config ---------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

PGHOST=xxx
PGDATABASE=xxx
PGPORT=5432
PG_USER = xxx
PG_PASSWORD = xxx

# ---- AI Video Pipeline -------------------------------------------------------

# Anthropic Claude (animation spec generation)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini (scene planning + script generation + captions)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI key kept for reference (no longer used for pipeline)
OPENAI_API_KEY=sk-...

# Google Veo 3.1 Lite (per-scene image-to-video generation, via the Gemini API)
# Defaults to GEMINI_API_KEY above; set VEO_API_KEY only to use a separate key.
VEO_API_KEY=
# Model id. Default: veo-3.1-lite-generate-preview (cost-effective, 720p/1080p)
VEO_MODEL_NAME=veo-3.1-lite-generate-preview
# Output resolution: 720p (default) or 1080p (1080p requires an 8s duration)
VEO_RESOLUTION=720p
# Fallback clip length in seconds (Veo accepts only 4, 6 or 8) when a scene has none
VEO_DURATION=8
# Fallback aspect ratio when a scene has none: 16:9 or 9:16 (Veo's only options)
VEO_ASPECT_RATIO=9:16
# Optional negative prompt applied to every generation
VEO_NEGATIVE_PROMPT=

# ElevenLabs TTS — pipeline voice engine
# Obtain at https://elevenlabs.io/app/settings/api-keys
# Key permissions needed: Text to Speech (Voices: Read optional, for tooling)
ELEVENLABS_API_KEY=xxx
# Voice for the marketing voice-over. Default: Sarah (free-tier premade)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# eleven_v3 is the only ElevenLabs model that supports Thai
ELEVENLABS_TTS_MODEL=eleven_v3
# v3 stability: 0.0 = Creative (default), 0.5 = Natural, 1.0 = Robust
ELEVENLABS_STABILITY=0.0

# FFmpeg (video composition + subtitle burn-in)
# Leave blank to use system PATH. Set to absolute path if FFmpeg is not in PATH.
FFMPEG_PATH=
# Temporary directory for FFmpeg intermediate files (must be writable)
FFMPEG_TMP_DIR=/tmp/clipper

# ---- Social Media Publishing -------------------------------------------------

# YouTube Data API v3
# Create OAuth credentials at https://console.cloud.google.com/
# Use the offline refresh-token flow to obtain a long-lived refresh token.
YOUTUBE_CLIENT_ID=xxx
YOUTUBE_CLIENT_SECRET=xxx
YOUTUBE_REFRESH_TOKEN=xxx

# TikTok Content Posting API
# Register your app at https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=xxx
TIKTOK_ACCESS_TOKEN=xxx

# Instagram Graph API (requires Facebook Business Manager)
INSTAGRAM_ACCESS_TOKEN=xxx
INSTAGRAM_PAGE_ID=xxx

# Facebook Graph API (Page video upload)
FACEBOOK_PAGE_TOKEN=xxx
FACEBOOK_PAGE_ID=xxx

# Travy internal API
TRAVY_API_KEY=xxx
TRAVY_API_URL=https://api.travy.app
# ---- Payments: Stripe (PromptPay QR) ----------------------------------------
# Stripe PromptPay QR. Enable PromptPay in the Stripe Dashboard and register:
# https://your-domain.example/api/payments/stripe/webhook
# Subscribe the endpoint to payment_intent.succeeded.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Minutes a generated PromptPay QR stays payable:
PAYMENT_INTENT_TTL_MINUTES=30
# Google Maps browser coordinate picker
# Restrict this browser key to your RClipper domains and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---- Native mobile stores and push notifications ----------------------------
# App Store Server API key (Users and Access > Integrations > In-App Purchase)
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APP_STORE_BUNDLE_ID=com.rclipper.app

# Google Play Android Publisher service account with order/purchase access
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_PLAY_PACKAGE_NAME=com.rclipper.app

# Firebase Cloud Messaging HTTP v1 service account
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Apple Push Notification service token key
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=com.rclipper.app
# sandbox for development/TestFlight-style development builds; production for App Store
APNS_ENVIRONMENT=sandbox

# Web Push (browser notifications) — VAPID keys.
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (NEXT_PUBLIC_*); the PRIVATE key stays
# server-side. VAPID_SUBJECT must be a mailto: or https: URL identifying the sender.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rclipper.com

# Optional: log per-query request-detail page timings on the server.
REQUEST_DETAIL_PERF_LOG=0
NEW_REQUEST_PERF_LOG=0

# ---- RClipper Management ----------------------------------------------------
# An area where videos are collected — transferred from a completed generation
# project, or uploaded by the user — and published to the user's OWN social
# accounts via Post for Me.
#
# FREE vs PAID: collecting content is free. Transferring is free and optional,
# and uploading your own video is free. Money is required only immediately
# before a video is submitted to social channels.
#
# PAYMENT: bought with CREDITS. Credits are topped up through the existing
# verified rails (Stripe on web, Apple IAP / Google Play Billing in the native
# apps), so this feature adds NO new payment provider and no new payment
# webhook. Every product is a ONE-TIME purchase — nothing renews.

# Master switch. ON by default — you do NOT need to set this to use the feature.
# Set it to "false" only to disable Management as an emergency rollback.
# RCLIPPER_MANAGEMENT_ENABLED=false

# Staged rollout (all optional). If ANY allowlist is set, the percentage rollout
# is ignored — a typo'd allowlist must never silently open the feature to all.
RCLIPPER_MANAGEMENT_ALLOWED_EMAILS=
RCLIPPER_MANAGEMENT_ALLOWED_DOMAINS=
RCLIPPER_MANAGEMENT_ALLOWED_USER_IDS=
# 0-100, bucketed deterministically by user id. Default 100.
RCLIPPER_MANAGEMENT_ROLLOUT_PERCENT=100

# How long a stored Management video is kept before being purged, in days.
# The RECORD, its publishing history and any purchased unlock last indefinitely;
# the FILE does not. Media is held past this window while a scheduled post still
# needs it. Add a bucket lifecycle backstop on the `management_uploads/` prefix
# comfortably LONGER than this, so the backstop never fires before the app purge.
RCLIPPER_MANAGEMENT_MEDIA_RETENTION_DAYS=90

# Largest single video a user may upload into Management, in bytes (default 2 GB).
RCLIPPER_MANAGEMENT_UPLOAD_MAX_BYTES=2147483648

# ---- Post for Me (social publishing provider) -------------------------------
# SERVER ONLY. This is a PROJECT-LEVEL key with full control over every
# connected account — never expose it to the browser and never log it.
# Use a separate project (and therefore key) per environment.
POST_FOR_ME_API_KEY=
POST_FOR_ME_BASE_URL=https://api.postforme.dev
# Returned when you create a webhook via POST /v1/webhooks. Delivered back to us
# in the "Post-For-Me-Webhook-Secret" header on every event.
POST_FOR_ME_WEBHOOK_SECRET=
# "quickstart" (Post for Me's app credentials, their brand on the consent
# screen) or "white_label" (our own credentials, requires per-platform review).
POST_FOR_ME_PROJECT_TYPE=quickstart
POST_FOR_ME_ENVIRONMENT=development
POST_FOR_ME_TIMEOUT_MS=20000
